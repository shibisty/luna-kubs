# Шаблон — ${MAIL_DOMAIN} подставляется entrypoint-скриптом (envsubst) при старте.

myhostname = mail.${MAIL_DOMAIN}
mydomain = ${MAIL_DOMAIN}
myorigin = $mydomain

# Что считаем "локальной" почтой, принимаемой напрямую (без relay дальше).
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain

# Только IPv4 — в большинстве Docker-окружений IPv6 всё равно не настроен
# нормально, а половинчатая поддержка чаще создаёт проблемы, чем решает.
inet_protocols = ipv4
inet_interfaces = all

# Relaying is granted to authenticated users only, never by address: behind a
# load balancer or in a pod network every client can look "local".
mynetworks = 127.0.0.0/8

# TLS для клиентских соединений (submission/587) — сертификаты те же,
# что и у nginx (Let's Encrypt), монтируются как volume.
# MAIL_TLS_CERT / MAIL_TLS_KEY (entrypoint.sh): certbot's files in compose,
# cert-manager's Secret in Kubernetes.
smtpd_tls_cert_file = ${MAIL_TLS_CERT}
smtpd_tls_key_file  = ${MAIL_TLS_KEY}
smtpd_tls_security_level = may
smtpd_use_tls = yes

# SASL-авторизация через Dovecot — так submission (587) требует логин/пароль
# перед отправкой, а не открытый релей для всех подряд.
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_relay_restrictions = permit_sasl_authenticated, permit_mynetworks, reject_unauth_destination

mailbox_size_limit = 0
recipient_delimiter = +

# ВАЖНО: реальную доставку почты (mailbox format, virtual users) здесь
# не настраиваю в деталях — для Laravel как отправителя транзакционных писем
# обычно достаточно ровно этого: SMTP + SASL-авторизация на 587. Если нужны
# ещё и полноценные почтовые ящики для чтения писем — потребуется отдельно
# настроить virtual_mailbox_domains/virtual_mailbox_maps и дать Dovecot
# доступ к тем же данным (см. dovecot.conf.template).
