# Copy to secrets.env (git-ignored) and fill in; kustomize turns it into
# the luna-secrets Secret. Generate the two service secrets with luna-cli:
#   go run . key:generate --env ../k8s/local/secrets.env --name AUTH_JWT_SECRET
#   go run . key:generate --env ../k8s/local/secrets.env --name LUNA_SERVICE_TOKEN
# Passwords go into DSNs: URL-safe characters only.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
DASHBOARD_DB_PASSWORD=
PAGES_DB_PASSWORD=
AUTH_JWT_SECRET=
LUNA_SERVICE_TOKEN=
