# Copy to settings.env (git-ignored) and fill in: the public names of the
# stack and the Let's Encrypt account. Each host needs a DNS record:
#   AUTH_HOST, DASHBOARD_HOST, PAGES_HOST, FILES_HOST,
#   WEBMAIL_HOST                             A  → the web load balancer (luna-nginx)
#   MAIL_HOST                                A  → the mail load balancer (luna-mail)
#   MAIL_DOMAIN                              MX → MAIL_HOST
# The certificates are issued by DNS-01 through DigitalOcean DNS, so the
# domain's DNS must be hosted at DigitalOcean (Networking → Domains).
AUTH_HOST=auth.example.com
DASHBOARD_HOST=dashboard.example.com
PAGES_HOST=pages.example.com
FILES_HOST=files.example.com
WEBMAIL_HOST=webmail.example.com
# mail.MAIL_DOMAIN: postfix calls itself that.
MAIL_HOST=mail.example.com
# The mail domain: addresses are user@MAIL_DOMAIN.
MAIL_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
# luna-auth's password reset emails, sent through the mail server (port 587).
# luna-auth logs in to the mail server as this mailbox (secrets.env MAIL_USERNAME@MAIL_DOMAIN).
AUTH_MAIL_USERNAME=noreply@example.com
AUTH_MAIL_FROM=Luna <noreply@example.com>
# luna-files' Spaces bucket (Spaces Object Storage → Create, with the CDN on);
# the key is in secrets.env. FILES_PUBLIC_URL is the CDN endpoint (or a custom
# domain on it); public files are read from there. The bucket's CORS must
# allow PUT from DASHBOARD_HOST (and the clients' sites that upload) with the
# Content-Type and x-amz-acl headers.
FILES_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
FILES_S3_REGION=fra1
FILES_S3_BUCKET=luna-files
FILES_PUBLIC_URL=https://luna-files.fra1.cdn.digitaloceanspaces.com
FILES_QUOTA=1GiB
# Old versions kept per file when its content is replaced (0: none).
FILES_KEEP_VERSIONS=10
# The bucket's CDN endpoint id (doctl compute cdn list), so luna-files purges a
# public file's old copy when it changes; needs FILES_DO_TOKEN in secrets.env.
FILES_CDN_ENDPOINT_ID=
