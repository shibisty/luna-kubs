# The gtr package registry (gtr-registry, namespace gtr): a client application
# of Luna that shares this edge and its certificate. Skipped by startup.sh when
# GTR_HOST is not set.
server {
    server_name ${GTR_HOST};
    listen 443 ssl proxy_protocol;
    http2 on;
    # cert-manager keeps the certificate (Secret luna-tls) up to date;
    # startup.sh reloads nginx every 6 hours to pick up a renewed one.
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # gtr publish sends archives of up to 50 MB.
    client_max_body_size 51m;

    # Resolved per request: nginx starts even when the registry is not deployed.
    resolver kube-dns.kube-system.svc.cluster.local valid=30s;
    set $gtr http://gtr-registry.gtr.svc.cluster.local:4873;

    location / {
        proxy_pass $gtr;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        # The client, as the DigitalOcean load balancer reports it (PROXY protocol).
        proxy_set_header X-Real-IP $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For $proxy_protocol_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
