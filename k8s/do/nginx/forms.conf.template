# luna-forms: what visitors send through the sites' forms (public, CORS *),
# runtime.js for the published pages, and the forms API (API keys).
server {
    server_name ${FORMS_HOST};
    listen 443 ssl proxy_protocol;
    http2 on;
    # cert-manager keeps the certificate (Secret luna-tls) up to date;
    # startup.sh reloads nginx every 6 hours to pick up a renewed one.
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Submissions with files: FORMS_MAX_UPLOAD (25 MiB) and the form fields.
    client_max_body_size 26m;

    # The dashboard's API, for the cluster network only.
    location /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://luna-forms:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The client, as the DigitalOcean load balancer reports it (PROXY protocol).
        proxy_set_header X-Real-IP $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For $proxy_protocol_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
