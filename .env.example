# docker compose reads this file as .env (copy it; .env is git-ignored).

AUTH_DOMAIN=auth.luna.local
DASHBOARD_DOMAIN=dashboard.luna.local
PAGES_DOMAIN=pages.luna.local
FILES_DOMAIN=files.luna.local
MAIL_DOMAIN=mail.luna.local
LETSENCRYPT_EMAIL=

MAIL_USERNAME=
MAIL_PASSWORD=

# Build: a GitHub token for gtr (the GitHub API allows 60 anonymous requests
# an hour). Any token works; it is passed as a build secret, not stored.
GITHUB_TOKEN=

# Secrets of the services. Generate each with luna-cli, from luna-cli/:
#   go run . key:generate --env ../.env --name AUTH_JWT_SECRET
#   go run . key:generate --env ../.env --name LUNA_SERVICE_TOKEN
AUTH_JWT_SECRET=
# luna-auth's token for the dashboard's key introspection (both sides).
LUNA_SERVICE_TOKEN=

# local: reset links go to luna-auth's log instead of email. production needs AUTH_MAIL_HOST.
APP_ENV=local

# Database passwords. Used when the postgres volume is first created; the
# defaults are for local work only. URL-safe characters, they go into DSNs.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
DASHBOARD_DB_PASSWORD=
PAGES_DB_PASSWORD=
FILES_DB_PASSWORD=

# luna-auth's SMTP for password reset emails (empty: log only, APP_ENV=local).
AUTH_MAIL_HOST=
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_MAIL_FROM=Luna <no-reply@luna.local>

# luna-files: disk (the files-data volume, default) or s3 (DigitalOcean
# Spaces: a bucket and a Spaces access key; FILES_PUBLIC_URL is the bucket's
# CDN endpoint, https://<bucket>.<region>.cdn.digitaloceanspaces.com).
FILES_STORAGE=disk
FILES_S3_ENDPOINT=
FILES_S3_REGION=
FILES_S3_BUCKET=
FILES_S3_KEY=
FILES_S3_SECRET=
FILES_PUBLIC_URL=
FILES_QUOTA=1GiB
